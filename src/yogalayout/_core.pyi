"""
Low-level nanobind bindings for Yoga (use the yogalayout package, not this module)
"""

import enum
from collections.abc import Iterator

YOGA_VERSION: str = "3.2.1"

UNDEFINED: float = ...

class Direction(enum.Enum):
    INHERIT = 0

    LTR = 1

    RTL = 2

class FlexDirection(enum.Enum):
    COLUMN = 0

    COLUMN_REVERSE = 1

    ROW = 2

    ROW_REVERSE = 3

class Justify(enum.Enum):
    FLEX_START = 0

    CENTER = 1

    FLEX_END = 2

    SPACE_BETWEEN = 3

    SPACE_AROUND = 4

    SPACE_EVENLY = 5

class Align(enum.Enum):
    AUTO = 0

    FLEX_START = 1

    CENTER = 2

    FLEX_END = 3

    STRETCH = 4

    BASELINE = 5

    SPACE_BETWEEN = 6

    SPACE_AROUND = 7

    SPACE_EVENLY = 8

class Wrap(enum.Enum):
    NO_WRAP = 0

    WRAP = 1

    WRAP_REVERSE = 2

class PositionType(enum.Enum):
    STATIC = 0

    RELATIVE = 1

    ABSOLUTE = 2

class Display(enum.Enum):
    FLEX = 0

    NONE = 1

    CONTENTS = 2

class Overflow(enum.Enum):
    VISIBLE = 0

    HIDDEN = 1

    SCROLL = 2

class BoxSizing(enum.Enum):
    BORDER_BOX = 0

    CONTENT_BOX = 1

class Edge(enum.Enum):
    LEFT = 0

    TOP = 1

    RIGHT = 2

    BOTTOM = 3

    START = 4

    END = 5

    HORIZONTAL = 6

    VERTICAL = 7

    ALL = 8

class Gutter(enum.Enum):
    COLUMN = 0

    ROW = 1

    ALL = 2

class Unit(enum.Enum):
    UNDEFINED = 0

    POINT = 1

    PERCENT = 2

    AUTO = 3

class MeasureMode(enum.Enum):
    UNDEFINED = 0

    EXACTLY = 1

    AT_MOST = 2

class Errata(enum.Flag):
    NONE = 0

    STRETCH_FLEX_BASIS = 1

    ABSOLUTE_POSITION_WITHOUT_INSETS_EXCLUDES_PADDING = 2

    ABSOLUTE_PERCENT_AGAINST_INNER_SIZE = 4

    CLASSIC = 2147483646

    ALL = 2147483647

class ExperimentalFeature(enum.Enum):
    WEB_FLEX_BASIS = 0

class Value:
    def __init__(self, value: float, unit: Unit) -> None: ...
    @property
    def value(self) -> float: ...
    @value.setter
    def value(self, arg: float, /) -> None: ...
    @property
    def unit(self) -> Unit: ...
    @unit.setter
    def unit(self, arg: Unit, /) -> None: ...
    def __eq__(self, arg: object, /) -> bool: ...

class Layout:
    @property
    def left(self) -> float: ...
    @property
    def top(self) -> float: ...
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def right(self) -> float: ...
    @property
    def bottom(self) -> float: ...
    def __iter__(self) -> Iterator: ...
    def __eq__(self, arg: object, /) -> bool: ...

class Config:
    def __init__(self) -> None: ...
    @property
    def use_web_defaults(self) -> bool: ...
    @use_web_defaults.setter
    def use_web_defaults(self, arg: bool, /) -> None: ...
    @property
    def point_scale_factor(self) -> float: ...
    @point_scale_factor.setter
    def point_scale_factor(self, arg: float, /) -> None: ...
    @property
    def errata(self) -> Errata: ...
    @errata.setter
    def errata(self, arg: Errata, /) -> None: ...
    def set_experimental_feature(self, arg0: ExperimentalFeature, arg1: bool, /) -> None: ...
    def is_experimental_feature_enabled(self, arg: ExperimentalFeature, /) -> bool: ...

class Node:
    def __init__(self, config: object | None = None) -> None: ...
    @property
    def config(self) -> object: ...
    def insert_child(self, child: object, index: int | None = None) -> None: ...
    def remove_child(self, child: object) -> None: ...
    def remove_all_children(self) -> None: ...
    @property
    def children(self) -> tuple: ...
    def child(self, index: int) -> object: ...
    def __len__(self) -> int: ...
    @property
    def parent(self) -> object: ...
    def calculate_layout(
        self,
        width: float | None = None,
        height: float | None = None,
        direction: Direction = Direction.LTR,
    ) -> None: ...
    @property
    def layout(self) -> Layout: ...
    @property
    def layout_direction(self) -> Direction: ...
    @property
    def had_overflow(self) -> bool: ...
    def layout_margin(self, edge: Edge) -> float: ...
    def layout_padding(self, edge: Edge) -> float: ...
    def layout_border(self, edge: Edge) -> float: ...
    @property
    def has_new_layout(self) -> bool: ...
    @has_new_layout.setter
    def has_new_layout(self, arg: bool, /) -> None: ...
    @property
    def is_dirty(self) -> bool: ...
    def mark_dirty(self) -> None: ...
    def set_measure(self, fn: object | None) -> None: ...
    def set_baseline(self, fn: object | None) -> None: ...
    def set_dirtied(self, fn: object | None) -> None: ...
    @property
    def direction(self) -> Direction: ...
    @direction.setter
    def direction(self, arg: Direction, /) -> None: ...
    @property
    def flex_direction(self) -> FlexDirection: ...
    @flex_direction.setter
    def flex_direction(self, arg: FlexDirection, /) -> None: ...
    @property
    def justify_content(self) -> Justify: ...
    @justify_content.setter
    def justify_content(self, arg: Justify, /) -> None: ...
    @property
    def align_content(self) -> Align: ...
    @align_content.setter
    def align_content(self, arg: Align, /) -> None: ...
    @property
    def align_items(self) -> Align: ...
    @align_items.setter
    def align_items(self, arg: Align, /) -> None: ...
    @property
    def align_self(self) -> Align: ...
    @align_self.setter
    def align_self(self, arg: Align, /) -> None: ...
    @property
    def position_type(self) -> PositionType: ...
    @position_type.setter
    def position_type(self, arg: PositionType, /) -> None: ...
    @property
    def flex_wrap(self) -> Wrap: ...
    @flex_wrap.setter
    def flex_wrap(self, arg: Wrap, /) -> None: ...
    @property
    def overflow(self) -> Overflow: ...
    @overflow.setter
    def overflow(self, arg: Overflow, /) -> None: ...
    @property
    def display(self) -> Display: ...
    @display.setter
    def display(self, arg: Display, /) -> None: ...
    @property
    def box_sizing(self) -> BoxSizing: ...
    @box_sizing.setter
    def box_sizing(self, arg: BoxSizing, /) -> None: ...
    @property
    def flex(self) -> float: ...
    @flex.setter
    def flex(self, arg: float, /) -> None: ...
    @property
    def flex_grow(self) -> float: ...
    @flex_grow.setter
    def flex_grow(self, arg: float, /) -> None: ...
    @property
    def flex_shrink(self) -> float: ...
    @flex_shrink.setter
    def flex_shrink(self, arg: float, /) -> None: ...
    @property
    def aspect_ratio(self) -> float: ...
    @aspect_ratio.setter
    def aspect_ratio(self, arg: float, /) -> None: ...
    @property
    def width(self) -> Value: ...
    @width.setter
    def width(self, arg: object | None, /) -> None: ...
    @property
    def height(self) -> Value: ...
    @height.setter
    def height(self, arg: object | None, /) -> None: ...
    @property
    def flex_basis(self) -> Value: ...
    @flex_basis.setter
    def flex_basis(self, arg: object | None, /) -> None: ...
    @property
    def min_width(self) -> Value: ...
    @min_width.setter
    def min_width(self, arg: object | None, /) -> None: ...
    @property
    def min_height(self) -> Value: ...
    @min_height.setter
    def min_height(self, arg: object | None, /) -> None: ...
    @property
    def max_width(self) -> Value: ...
    @max_width.setter
    def max_width(self, arg: object | None, /) -> None: ...
    @property
    def max_height(self) -> Value: ...
    @max_height.setter
    def max_height(self, arg: object | None, /) -> None: ...
    def get_margin(self, edge: Edge) -> Value: ...
    def set_margin(self, edge: Edge, value: object | None) -> None: ...
    def get_padding(self, edge: Edge) -> Value: ...
    def set_padding(self, edge: Edge, value: object | None) -> None: ...
    def get_position(self, edge: Edge) -> Value: ...
    def set_position(self, edge: Edge, value: object | None) -> None: ...
    def get_border(self, edge: Edge) -> float: ...
    def set_border(self, edge: Edge, value: float) -> None: ...
    def get_gap(self, gutter: Gutter) -> float: ...
    def set_gap(self, gutter: Gutter, value: object | None) -> None: ...
